# /etc/cron.d/the-other-wife-backend — install on the droplet with:
#   sudo cp deploy/cron/the-other-wife-backend /etc/cron.d/the-other-wife-backend
#   sudo chmod 644 /etc/cron.d/the-other-wife-backend
# (cron.d files need a trailing newline, no dots in the file name, and are
# picked up automatically — no restart needed.)
#
# Calls the app directly on 127.0.0.1 (the container's published port), so
# it doesn't depend on DNS, TLS or nginx. CRON_SECRET is read from the env
# file on every run. Only failures are logged.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Partner status tracking + webhooks, every 5 minutes (production).
*/5 * * * * root /bin/bash /opt/the-other-wife-backend/scripts/cron-call.sh /opt/the-other-wife-backend/.env.prod http://127.0.0.1:8000 /api/v1/internal/cron/partner-webhooks/run >/dev/null 2>>/var/log/tow-cron.log

# Unpaid checkout expiry, every 5 minutes (production). Closes checkouts left
# unpaid for ORDER_PAYMENT_TTL_MINUTES (default 30) after re-checking each with
# Paystack — a paid one is confirmed instead — and releases reserved wallet
# funds and promo uses. Enabled in production after the dry run was reviewed
# (see DEPLOYMENT.md, "Unpaid checkout expiry").
*/5 * * * * root /bin/bash /opt/the-other-wife-backend/scripts/cron-call.sh /opt/the-other-wife-backend/.env.prod http://127.0.0.1:8000 /api/v1/internal/cron/orders/expire-unpaid >/dev/null 2>>/var/log/tow-cron.log

# Automatic vendor payouts: settle Paystack transfers still waiting on the
# bank (backs up the transfer webhooks). Does nothing while
# PAYOUT_TRANSFERS_ENABLED is off, so it is safe to install now.
*/5 * * * * root /bin/bash /opt/the-other-wife-backend/scripts/cron-call.sh /opt/the-other-wife-backend/.env.prod http://127.0.0.1:8000 /api/v1/internal/cron/payouts/reconcile >/dev/null 2>>/var/log/tow-cron.log

# Staging (uncomment once staging is deployed per DEPLOYMENT.md).
# */5 * * * * root /bin/bash /opt/the-other-wife-backend-staging/scripts/cron-call.sh /opt/the-other-wife-backend-staging/.env.staging http://127.0.0.1:8001 /api/v1/internal/cron/partner-webhooks/run >/dev/null 2>>/var/log/tow-cron-staging.log
# */5 * * * * root /bin/bash /opt/the-other-wife-backend-staging/scripts/cron-call.sh /opt/the-other-wife-backend-staging/.env.staging http://127.0.0.1:8001 /api/v1/internal/cron/orders/expire-unpaid >/dev/null 2>>/var/log/tow-cron-staging.log
