# Login for the full internal API docs (/tow, /api-docs.json, /redoc).
# Not needed when NODE_ENV=development (docs are open locally). Everywhere
# else the docs require this login, and are disabled if either is empty.
# Use a long random password.
DOCS_USERNAME=
DOCS_PASSWORD=

# Encrypts partner webhook and request-signing secrets (AES-256-GCM).
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before configuring a partner webhook or a signed partner key.
# Changing it makes existing partner signing secrets unreadable.
PARTNER_SECRETS_KEY=
