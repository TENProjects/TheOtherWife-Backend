NODE_ENV=production
PORT=8000
HOST_NAME=http://localhost
MONGODB_URI=mongodb://localhost:27017/the_other_wife

JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_too

GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

CORS_ORIGIN=http://localhost:3000

RESEND_API_KEY=
FROM=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Leave empty until app 1.0.3 is widely installed, then set to
# https://<api-domain>/api/v1/payments/paystack/return (see DEPLOYMENT.md).
PAYSTACK_CALLBACK_URL=
# Unpaid checkouts are closed after this many minutes (re-checked with
# Paystack first); one Paystack can't confirm is closed after the max age.
ORDER_PAYMENT_TTL_MINUTES=30
ORDER_PAYMENT_MAX_AGE_HOURS=24

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EXPO_ACCESS_TOKEN=

FRONTEND_URL=http://localhost:3000
RESET_PASSWORD_TOKEN_TTL_MINUTES=30
# Customers see HomeChefs within this distance (km) of their default address.
# Capped at 5 by the business rule; a lower value narrows it further.
SEARCH_RADIUS_KM=5

CRON_SECRET=
LEDGER_CHECKPOINT_EMAIL=

# Login for the full internal API docs (/tow, /api-docs.json, /redoc).
# Not needed when NODE_ENV=development (docs are open locally). Everywhere
# else the docs require this login, and are disabled if either is empty.
# Use a long random password.
DOCS_USERNAME=
DOCS_PASSWORD=

# Encrypts partner webhook and request-signing secrets (AES-256-GCM).
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before configuring a partner webhook or a signed partner key.
# Changing it makes existing partner signing secrets unreadable.
PARTNER_SECRETS_KEY=
